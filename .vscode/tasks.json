{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IFOROS: Start local development",
      "type": "shell",
      "command": "node scripts/dev.cjs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "IFOROS: Tests",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "IFOROS: Syntax checks",
      "type": "shell",
      "command": "npm run check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "IFOROS: Verify before commit",
      "dependsOrder": "sequence",
      "dependsOn": ["IFOROS: Syntax checks", "IFOROS: Tests"],
      "problemMatcher": []
    }
  ]
}
